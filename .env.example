# Point this at your running FastAPI pipeline server (see /pipeline_server).
# Leave empty to fall back to USE_MOCK_DATA.
PIPELINE_API_URL=

# When PIPELINE_API_URL is empty, set this to "true" to preview the UI using
# real sample output from the op-amp lecture run (auto_notes_output_comparison.txt)
# instead of calling any backend.
USE_MOCK_DATA=true
